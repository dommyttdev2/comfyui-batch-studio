{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ComfyUI Batch Studio Prompt Plan",
  "description": "Formal JSON Schema for prompt_plan.json schemaVersion 1 and 2.",
  "oneOf": [
    {
      "$ref": "#/$defs/planV1"
    },
    {
      "$ref": "#/$defs/planV2"
    }
  ],
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9._-]{0,63}$"
    },
    "loraUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelRef",
        "strengthModel",
        "strengthClip"
      ],
      "properties": {
        "modelRef": {
          "type": "string",
          "minLength": 1
        },
        "strengthModel": {
          "type": "number"
        },
        "strengthClip": {
          "type": "number"
        }
      }
    },
    "commonPromptV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "positive",
        "negative"
      ],
      "properties": {
        "positive": {
          "type": "string"
        },
        "negative": {
          "type": "string"
        }
      }
    },
    "leafV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "positive",
        "negative"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "positive": {
          "type": "string"
        },
        "negative": {
          "type": "string"
        }
      }
    },
    "branchV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "loras",
        "leaves"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "loras": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/loraUsage"
          }
        },
        "leaves": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/leafV1"
          }
        }
      }
    },
    "planV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "common",
        "rootLoras",
        "branches"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "common": {
          "$ref": "#/$defs/commonPromptV1"
        },
        "rootLoras": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/loraUsage"
          }
        },
        "branches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/branchV1"
          }
        }
      }
    },
    "tagArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^,\\r\\n]+$"
      }
    },
    "cameraGroups": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pov": {
          "$ref": "#/$defs/tagArray"
        },
        "angle": {
          "$ref": "#/$defs/tagArray",
          "maxItems": 1
        },
        "framing": {
          "$ref": "#/$defs/tagArray",
          "maxItems": 1
        },
        "gaze": {
          "$ref": "#/$defs/tagArray",
          "maxItems": 1
        },
        "focus": {
          "$ref": "#/$defs/tagArray"
        }
      }
    },
    "positiveGroups": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject": {
          "$ref": "#/$defs/tagArray"
        },
        "identity": {
          "$ref": "#/$defs/tagArray"
        },
        "appearance": {
          "$ref": "#/$defs/tagArray"
        },
        "style": {
          "$ref": "#/$defs/tagArray"
        },
        "outfit": {
          "$ref": "#/$defs/tagArray"
        },
        "expression": {
          "$ref": "#/$defs/tagArray",
          "maxItems": 3
        },
        "action": {
          "$ref": "#/$defs/tagArray"
        },
        "pose": {
          "$ref": "#/$defs/tagArray"
        },
        "camera": {
          "$ref": "#/$defs/cameraGroups"
        },
        "environment": {
          "$ref": "#/$defs/tagArray"
        },
        "lighting": {
          "$ref": "#/$defs/tagArray"
        },
        "effects": {
          "$ref": "#/$defs/tagArray"
        }
      }
    },
    "negativeGroups": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "anatomy": {
          "$ref": "#/$defs/tagArray"
        },
        "identity": {
          "$ref": "#/$defs/tagArray"
        },
        "appearance": {
          "$ref": "#/$defs/tagArray"
        },
        "subject": {
          "$ref": "#/$defs/tagArray"
        },
        "outfit": {
          "$ref": "#/$defs/tagArray"
        },
        "action": {
          "$ref": "#/$defs/tagArray"
        },
        "camera": {
          "$ref": "#/$defs/tagArray"
        },
        "environment": {
          "$ref": "#/$defs/tagArray"
        },
        "artifacts": {
          "$ref": "#/$defs/tagArray"
        },
        "content": {
          "$ref": "#/$defs/tagArray"
        }
      }
    },
    "structuredPrompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "positive",
        "negative"
      ],
      "properties": {
        "positive": {
          "$ref": "#/$defs/positiveGroups"
        },
        "negative": {
          "$ref": "#/$defs/negativeGroups"
        },
        "triggerWords": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/triggerWordSelection"
          }
        }
      }
    },
    "leafV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "prompt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "$ref": "#/$defs/structuredPrompt"
        }
      }
    },
    "branchV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "loras",
        "leaves"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "loras": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/loraUsage"
          }
        },
        "prompt": {
          "$ref": "#/$defs/structuredPrompt"
        },
        "leaves": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/leafV2"
          }
        }
      }
    },
    "planV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "common",
        "rootLoras",
        "branches"
      ],
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "common": {
          "$ref": "#/$defs/structuredPrompt"
        },
        "rootLoras": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/loraUsage"
          }
        },
        "branches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/branchV2"
          }
        },
        "triggerWordsMode": {
          "const": "selected"
        }
      }
    },
    "triggerWordSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelRef",
        "words"
      ],
      "properties": {
        "modelRef": {
          "type": "string",
          "minLength": 1
        },
        "words": {
          "$ref": "#/$defs/tagArray"
        }
      }
    }
  },
  "$comment": "Schema v1 remains readable/compilable for existing projects. New Grok Prompt Plans use v2. Batch Studio semantic validation additionally checks project-wide IDs, modelRef resolution, model-family tag dialect, cross-scope duplicates, positive/negative conflicts, and effective camera conflicts."
}
