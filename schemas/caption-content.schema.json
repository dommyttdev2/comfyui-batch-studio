{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "caption-content.schema.json",
  "title": "ComfyUI Batch Studio Caption Content",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "title",
    "description"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2
      ]
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ja",
        "en"
      ],
      "properties": {
        "ja": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "description": {
      "$ref": "#/$defs/bilingualLines"
    },
    "contents": {
      "$ref": "#/$defs/bilingualLines"
    },
    "pixivTitle": {
      "$ref": "#/$defs/pixivTitle"
    }
  },
  "$defs": {
    "bilingualLines": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ja",
        "en"
      ],
      "properties": {
        "ja": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "en": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "pixivTitle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ja",
        "en"
      ],
      "properties": {
        "ja": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[^\\r\\n\\u2028\\u2029]*$"
        },
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[^\\r\\n\\u2028\\u2029]*$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 1
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "pixivTitle"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "pixivTitle"
        ]
      }
    }
  ]
}
